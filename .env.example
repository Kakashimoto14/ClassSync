# Shared development configuration. Never add credentials to this file.
CLASSSYNC_ENV=development

# Firebase Admin (backend). Provide either FIREBASE_SERVICE_ACCOUNT_JSON or all fields below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gateway service URLs (container/Docker deployments can override these).
ACADEMIC_SERVICE_URL=http://127.0.0.1:8001
SCHEDULING_SERVICE_URL=http://127.0.0.1:8002
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8003

# Keep false outside local development. When false, gateway protected endpoints require a Firebase bearer token.
ALLOW_UNAUTHENTICATED_DEVELOPMENT=false

# Gateway identity-only PostgreSQL provider. Leave URL/tenant UNSET until an
# approved database and institutional membership source are configured.
# IDENTITY_DATABASE_URL=postgresql+psycopg://<runtime-user>@<host>:<port>/<database>
# INSTITUTIONAL_TENANT_ID=<approved-tenant-key>
# Default requires verified TLS using system roots and SCRAM authentication.
IDENTITY_DATABASE_TRANSPORT=verify-full
# loopback-sspi-test is restricted to CLASSSYNC_ENV=test; never use for deployment.
# No startup migrations. Each service independently verifies current membership.

# Optional Academic identity/data PostgreSQL provider. Leave UNSET until an
# approved runtime role/database exists; configuration never migrates originals.
# ACADEMIC_DATABASE_URL=postgresql+psycopg://<academic-runtime-user>@<host>:<port>/<database>
ACADEMIC_DATABASE_TRANSPORT=verify-full
# Missing configuration makes institutional Academic routes unavailable.
# Development sandbox remains separate; test-only SSPI is never a deployment fallback.

# Optional Scheduling identity/run/draft PostgreSQL provider. Leave UNSET until an
# approved runtime role/database exists; no startup DDL or original-data migration.
# SCHEDULING_DATABASE_URL=postgresql+psycopg://<scheduling-runtime-user>@<host>:<port>/<database>
SCHEDULING_DATABASE_TRANSPORT=verify-full
# PostgreSQL publication is unavailable until its own adapter is qualified.
# Missing institutional configuration fails closed; development sandbox stays separate.

# Scheduling/academic sandbox: requires BOTH flags in Gateway, Academic and Scheduling.
# Synthetic examples and entered-data previews use separate scopes; saved drafts remain immutable.
# Synthetic publication additionally requires a verified Administrator token; preview roles never grant it.
ENABLE_SCHEDULING_SANDBOX=false

# Relative to repository root; use durable local storage. Never commit database files.
SCHEDULING_DATABASE_PATH=var/scheduling.sqlite3
ACADEMIC_DATABASE_PATH=var/academic.sqlite3
