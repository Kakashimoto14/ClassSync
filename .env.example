# Shared development configuration. Never add credentials to this file.
CLASSSYNC_ENV=development

# Firebase Admin (backend). Provide either FIREBASE_SERVICE_ACCOUNT_JSON or all fields below.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Gateway service URLs (container/Docker deployments can override these).
ACADEMIC_SERVICE_URL=http://127.0.0.1:8001
SCHEDULING_SERVICE_URL=http://127.0.0.1:8002
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8003

# Keep false outside local development. When false, gateway protected endpoints require a Firebase bearer token.
ALLOW_UNAUTHENTICATED_DEVELOPMENT=false

# Scheduling/academic sandbox: requires BOTH flags in Gateway, Academic and Scheduling.
# Synthetic examples and entered-data previews use separate scopes; all drafts are unpublished.
ENABLE_SCHEDULING_SANDBOX=false

# Relative to repository root; use durable local storage. Never commit database files.
SCHEDULING_DATABASE_PATH=var/scheduling.sqlite3
ACADEMIC_DATABASE_PATH=var/academic.sqlite3
