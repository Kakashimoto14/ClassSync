# Copy to ignored .env.container.scheduling; no Gateway provisioning or Gemini keys.
FIREBASE_PROJECT_ID=
FIREBASE_USE_ADC=false
CLOUD_RUN_IAM_ENABLED=false
# POSTGRES_TLS_ROOT_CERT=/absolute/path/to/approved-server-ca.pem
INSTITUTIONAL_TENANT_ID=
SCHEDULING_DATABASE_URL=
SCHEDULING_DATABASE_TRANSPORT=verify-full
DATABASE_POOL_SIZE=2
# Only the Scheduling service's approved identity, if a mounted file is required.
GOOGLE_APPLICATION_CREDENTIALS=
