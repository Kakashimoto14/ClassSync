{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://classsync-o3u3.onrender.com/api/v1/:path*"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/auth/:path*", "destination": "/index.html" },
    { "source": "/dev/role-preview", "destination": "/index.html" },
    { "source": "/dev/design-system", "destination": "/index.html" },
    { "source": "/forbidden", "destination": "/index.html" },
    { "source": "/student/:path*", "destination": "/index.html" },
    { "source": "/teacher/:path*", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" }
  ]
}
