# Copy to ignored .env.container.gateway; only Gateway-scoped secrets belong here.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=<public Firebase Web API key for student ID/password sign-in>
FIREBASE_USE_ADC=false
CLOUD_RUN_IAM_ENABLED=false
# POSTGRES_TLS_ROOT_CERT=/absolute/path/to/approved-server-ca.pem
INSTITUTIONAL_TENANT_ID=
IDENTITY_DATABASE_URL=
IDENTITY_DATABASE_TRANSPORT=verify-full
DATABASE_POOL_SIZE=2
CORS_ORIGINS=[]
# Set these only after configuring Turnstile and a private Notification service.
# OTP_HMAC_SECRET must be at least 32 random bytes; use a distinct value from service tokens.
# TURNSTILE_SECRET_KEY=<Cloudflare Siteverify secret>
# OTP_HMAC_SECRET=<at least 32 random bytes; distinct from the service token>
# NOTIFICATION_SERVICE_TOKEN=<at least 32 random bytes; match Notification>
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8003
COURSE_CLOUD_ENABLED=false
COURSE_STORAGE_BUCKET=
COURSE_GEMINI_MODEL=
GEMINI_API_KEY=
# Use approved Gateway workload identity or mount its own secret file; never image-copy keys.
GOOGLE_APPLICATION_CREDENTIALS=
