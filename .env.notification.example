# Private email delivery configuration for services/notification.
CLASSSYNC_ENV=development
CLASSSYNC_WEB_URL=http://localhost:5173
EMAIL_PROVIDER=resend
# NOTIFICATION_SERVICE_TOKEN=<same private token as Gateway>
# RESEND_API_KEY=<Resend API key>
# RESEND_FROM_EMAIL=<verified sender on the configured domain>
# BREVO_API_KEY=<Brevo API key>
# BREVO_SENDER_EMAIL=<approved transactional sender address>
# BREVO_SENDER_NAME=ClassSync
