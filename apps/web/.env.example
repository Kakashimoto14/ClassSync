VITE_API_BASE_URL=/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional SDK metadata; Auth does not require a Storage bucket.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# The generated connected Vercel profile sets CLASSSYNC_BUILD_TARGET=connected.

# Optional canonical mode: presentation | sandbox | institutional.
# Plain Vite and ordinary builds default to the institutional interface.
# For development, explicitly select institutional to opt in to the configured Firebase provider.
# npm run dev launches the separate scheduling sandbox.
# Sandbox is NEVER allowed by any build command, even NODE_ENV=development.
# VITE_CLASSSYNC_MODE=presentation
# build:presentation explicitly selects presentation and rejects contradictions.
# Legacy booleans remain supported; omit them when using the canonical mode.
# VITE_ENABLE_ROLE_PREVIEW=true
# VITE_ENABLE_PRESENTATION_SAMPLE=true
# No frontend setting grants backend permission or real university identity.

# Optional separate origin serving the read-only presentation. HTTPS outside local Vite development.
# VITE_CLASSSYNC_PRESENTATION_URL=
